# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不要提交）

# ===== 必填 =====

# 网页登录密码。部署到服务器时必须设置
APP_PASSWORD=

# DeepSeek API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# B 站 Cookie：电脑浏览器登录 bilibili.com → F12 → Application（应用）→ Cookies
# → www.bilibili.com → 复制 SESSDATA 的值。也可以粘贴整段 Cookie。
# 用于读取你的收藏夹、拿 AI 字幕；充电专属视频需要已充电账号。大约半年过期一次，过期会推送提醒。
BILI_COOKIE=

# 要同步的收藏夹：填收藏夹名称（如 待整理），或 media_id，或收藏夹页面链接
# 运行 `bili-notes folders` 可以列出你的所有收藏夹
BILI_FAV_FOLDER=待整理

# ===== 推送通知（选一个或多个）=====

# Bark（iPhone）：App Store 安装 Bark，复制 App 里显示的 key
BARK_KEY=
# Server 酱（推送到微信）：https://sct.ftqq.com 获取 SendKey
SERVERCHAN_KEY=
# PushPlus（推送到微信）：https://www.pushplus.plus 获取 token
PUSHPLUS_TOKEN=

# 通知里「打开笔记」的链接前缀，填你访问网页的地址
PUBLIC_URL=http://你的服务器IP:8765

# ===== 可选 =====

# 同时同步「稍后再看」
# BILI_SYNC_WATCHLATER=true
# SYNC_INTERVAL_MINUTES=10
# 第一次同步只取最近收藏的 N 个视频，避免一次跑完整个老收藏夹
# INITIAL_SYNC_LIMIT=10
# 多 P 合集最多整理多少 P
# MAX_PARTS=10

# 模型：deepseek（默认）/ openai（任意 OpenAI 兼容接口：通义、Kimi、本地 Ollama 等）/ claude
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=
# LLM_API_KEY=
# ANTHROPIC_API_KEY=

# 没有字幕时的语音识别。服务器没有显卡，small 是速度和准确率的折中；内存 ≥4G 可以试 medium
# ASR_ENABLED=true
# WHISPER_MODEL=small
# 国内服务器下载语音识别模型需要走镜像
HF_ENDPOINT=https://hf-mirror.com

# 数据目录（SQLite 数据库和导出的 Markdown）
# DATA_DIR=data
