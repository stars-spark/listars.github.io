# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不要提交）

# Claude API Key：https://console.anthropic.com
ANTHROPIC_API_KEY=

# B 站 Cookie：浏览器登录 bilibili.com → F12 → Application/存储 → Cookies
# 可以只填 SESSDATA 的值，也可以粘贴整段 Cookie。
# 登录后才能拿到 AI 字幕；充电专属视频需要已充电账号的 Cookie。
BILI_COOKIE=

# 可选
# BILI_NOTES_DIR=notes
# BILI_NOTES_MODEL=claude-opus-5
# BILI_NOTES_EFFORT=high
# BILI_NOTES_WHISPER=large-v3-turbo   # 没有显卡建议用 small 或 medium
